generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

model User {
  id           String         @id @default(uuid()) @db.Char(36)
  email        String         @unique @db.VarChar(255)
  passwordHash String         @map("password_hash") @db.VarChar(255)
  createdAt    DateTime       @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt    DateTime       @updatedAt @map("updated_at") @db.DateTime(3)
  tokens       RefreshToken[]
  vocabularies Vocabulary[]

  @@map("users")
}

model RefreshToken {
  id        String    @id @default(uuid()) @db.Char(36)
  userId    String    @map("user_id") @db.Char(36)
  tokenHash String    @unique @map("token_hash") @db.Char(64)
  expiresAt DateTime  @map("expires_at") @db.DateTime(3)
  revokedAt DateTime? @map("revoked_at") @db.DateTime(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

model Vocabulary {
  id                String   @id @default(uuid()) @db.Char(36)
  userId            String   @map("user_id") @db.Char(36)
  englishWord       String   @map("english_word") @db.VarChar(150)
  normalizedWord    String   @map("normalized_word") @db.VarChar(150)
  vietnameseMeaning String   @map("vietnamese_meaning") @db.Text
  audioPath         String?  @map("audio_path") @db.VarChar(500)
  audioName         String?  @map("audio_name") @db.VarChar(255)
  audioType         String?  @map("audio_type") @db.VarChar(100)
  audioSize         BigInt?  @map("audio_size") @db.UnsignedBigInt
  exampleEnglish    String?  @map("example_english") @db.VarChar(500)
  exampleVietnamese String?  @map("example_vietnamese") @db.VarChar(1000)
  exampleAudioPath  String?  @map("example_audio_path") @db.VarChar(500)
  exampleAudioName  String?  @map("example_audio_name") @db.VarChar(255)
  exampleAudioType  String?  @map("example_audio_type") @db.VarChar(100)
  exampleAudioSize  BigInt?  @map("example_audio_size") @db.UnsignedBigInt
  createdAt         DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt         DateTime @updatedAt @map("updated_at") @db.DateTime(3)
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc)])
  @@index([userId, normalizedWord])
  @@map("vocabularies")
}

model AppSetting {
  key            String   @id @db.VarChar(100)
  encryptedValue String   @map("encrypted_value") @db.Text
  iv             String   @db.VarChar(32)
  authTag        String   @map("auth_tag") @db.VarChar(32)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.DateTime(3)

  @@map("app_settings")
}
